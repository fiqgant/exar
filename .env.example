# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Supabase Transaction Pooler recommended for serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x

# AI Encryption Key (32-character hex key for AES-256-GCM encryption of client API keys)
AI_API_SECRET_KEY=your-32-character-secret-key-here
